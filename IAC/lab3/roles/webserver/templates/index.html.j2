<!DOCTYPE html>
<!-- Template Jinja2: variabel {{ nama_variabel }} akan diganti nilai sebenarnya oleh Ansible -->
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{ site_title | default('IAC Lab') }}</title>
  <style>
    body {
      background: #0a0f1e;
      color: #e0e0e0;
      font-family: 'Segoe UI', monospace;
      padding: 2rem;
      margin: 0;
    }
    h1 { color: #4fc3f7; margin-bottom: 0.5rem; }
    .subtitle { color: #9e9e9e; font-size: 0.9rem; margin-bottom: 2rem; }
    .info-card {
      background: #1e2a3a;
      border: 1px solid #2d3f55;
      border-left: 4px solid #4fc3f7;
      border-radius: 0 8px 8px 0;
      padding: 1.2rem 1.5rem;
      margin-bottom: 1.5rem;
    }
    .info-card p { margin: 0.4rem 0; font-size: 0.9rem; }
    .badge {
      background: #4fc3f7;
      color: #000;
      padding: 0.15rem 0.6rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      display: inline-block;
      margin-bottom: 0.8rem;
    }
    .footer {
      color: #555;
      font-size: 0.75rem;
      margin-top: 3rem;
      border-top: 1px solid #1e2a3a;
      padding-top: 1rem;
    }
  </style>
</head>
<body>
  <h1>🚀 {{ site_title | default('IAC Hands-On Lab 3') }}</h1>
  <p class="subtitle">Halaman ini dibuat otomatis menggunakan Ansible Roles + Jinja2 Template</p>

  <div class="info-card">
    <span class="badge">ANSIBLE IAC</span>
    <p>🖥️ Hostname &nbsp;: <strong>{{ inventory_hostname }}</strong></p>
    <p>🐧 OS &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: {{ ansible_distribution }} {{ ansible_distribution_version }}</p>
    <p>🌐 IP Address : {{ ansible_default_ipv4.address | default('N/A') }}</p>
    <p>⏰ Dikonfigurasi: {{ ansible_date_time.iso8601 | default('N/A') }}</p>
  </div>

  <div class="info-card" style="border-left-color: #69f0ae;">
    <span class="badge" style="background: #69f0ae;">IAC INFO</span>
    <p>📁 Role &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: webserver</p>
    <p>📄 Template &nbsp;: index.html.j2 (Jinja2)</p>
    <p>🔁 Idempoten &nbsp;: Ya — aman dijalankan berulang kali</p>
  </div>

  <div class="footer">
    Matakuliah Advanced Services — Universitas Brawijaya 2025/2026
  </div>
</body>
</html>
